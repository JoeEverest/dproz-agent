# The x-api-key for the Dproz jobs API. Copy this file to .env and fill it in.
# It is read when the app is built and when it runs in development.
DPROZ_API_KEY=

# The PostHog project key for anonymous usage analytics (the public "phc_" key). Optional: without it
# the app sends nothing. Only an installed build reports; development and test runs do not.
DPROZ_AGENT_POSTHOG_KEY=
