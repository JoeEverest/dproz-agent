{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"jsx": "react-jsx",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true,
		"noEmit": true,
		"baseUrl": ".",
		"paths": { "@shared/*": ["src/shared/*"], "@/*": ["src/renderer/src/*"] }
	},
	"include": ["src/renderer/src/**/*", "src/shared/**/*", "src/preload/*.d.ts"]
}
